# SemanticMemo V2 Live Environment Configuration
# Safe local-development defaults

# PostgreSQL
POSTGRES_DSN=postgresql://postgres:postgres_dev_password@localhost:5432/semanticmemo
POSTGRES_DB=semanticmemo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST=localhost
KAFKA_PORT=9092

# SemanticMemo Config
SEMANTICMEMO_VECTOR_STORE_TYPE=qdrant
SEMANTICMEMO_LOCK_TYPE=redis
SEMANTICMEMO_STORE_TYPE=postgres
SEMANTICMEMO_EVENT_BUS_TYPE=kafka
